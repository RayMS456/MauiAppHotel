<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Sobre"
             Title="Sobre o app">


    <VerticalStackLayout Padding="10">
        <Label 
            Text="Hotel"
            FontSize="26"
            FontFamily="Kalam-Bold"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />


        <Label 
           Text="Sistema desenvolvido para fins educativos e de aprendizagem para Etec, do curso de desenvolvimento de sistemas"
           FontSize="20"
           VerticalOptions="Center" 
           HorizontalOptions="Center" />


        <Label 
             Text="Desenvolverdor (a): Rayssa Menezes Souza"
             TextColor="Purple"
             FontSize="16"
             VerticalOptions="Center" 
             HorizontalOptions="Center" />

        <Label
            Text="Ano de desenvolvimento: 2026"
            FontSize="14"
            TextColor="{StaticResource Magenta}"
            VerticalOptions="Center"
            HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>